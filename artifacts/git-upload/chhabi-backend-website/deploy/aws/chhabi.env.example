# Copy to /opt/chhabi/shared/.env and replace every CHANGE_ME value.
DEBUG=False
SECRET_KEY='CHANGE_ME_GENERATE_A_LONG_RANDOM_VALUE'
ALLOWED_HOSTS=hr.example.com
CSRF_TRUSTED_ORIGINS=https://hr.example.com
TIME_ZONE=Asia/Kolkata

# Amazon RDS for PostgreSQL. Keep the RDS instance private; its security group
# should accept TCP 5432 only from the EC2 security group.
DB_ENGINE=django.db.backends.postgresql
DB_NAME=chhabi
DB_USER=chhabi_app
DB_PASSWORD='CHANGE_ME_RDS_PASSWORD'
DB_HOST=CHANGE_ME.xxxxxxxxxxxx.ap-south-1.rds.amazonaws.com
DB_PORT=5432

# Private S3 media bucket. Leave AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY unset
# and attach the least-privilege IAM role described in README-AWS.md to EC2.
AWS_STORAGE_BUCKET_NAME=CHANGE_ME-chhabi-media
AWS_S3_REGION_NAME=ap-south-1
AWS_S3_ADDRESSING_STYLE=virtual
DEFAULT_FILE_STORAGE=chhabi.chhabi_backends.PrivateMediaStorage
MEDIA_URL=https://CHANGE_ME-chhabi-media.s3.ap-south-1.amazonaws.com
MEDIA_ROOT=https://CHANGE_ME-chhabi-media.s3.ap-south-1.amazonaws.com
NAMESPACE=private
