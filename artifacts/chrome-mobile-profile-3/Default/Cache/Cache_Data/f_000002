/* ============================================================
   GFT WEBSITE — PREMIUM DESIGN SYSTEM
   Base layer: tokens, reset, layout, buttons, header, footer,
   section shells, cards, forms. The cms-premium.css layer adds
   decoration, gradients, glows and hover motion.
   Supports [data-theme="light"|"dark"] on <html>.
   ============================================================ */

/* ---------- Design tokens ---------- */
:root {
  --brand: #5b63ee;
  --brand-2: #0b1635;
  --accent: #22d3ee;
  --violet: #8b5cf6;
  --success: #10b981;
  --warning: #f59e0b;
  --danger: #ef4444;

  --gradient: linear-gradient(135deg, var(--brand) 0%, var(--violet) 55%, var(--accent) 130%);
  --gradient-soft: linear-gradient(135deg, rgba(91,99,238,.14), rgba(139,92,246,.14));

  --bg: #f4f6fc;
  --surface: #ffffff;
  --surface-2: #eef1f9;
  --surface-3: #e6eaf6;
  --text: #0d1526;
  --text-soft: #33415c;
  --muted: #64748b;
  --border: #e3e8f2;
  --border-strong: #d3daea;

  --header: rgba(255, 255, 255, .82);
  --header-border: rgba(15, 23, 42, .08);
  --footer-bg: #0a1122;
  --footer-text: #c9d4e8;
  --footer-muted: #8ea0bd;

  --shadow-sm: 0 4px 14px rgba(15, 23, 42, .06);
  --shadow: 0 18px 50px rgba(15, 23, 42, .10);
  --shadow-lg: 0 30px 70px rgba(15, 23, 42, .16);
  --ring: 0 0 0 4px rgba(91, 99, 238, .18);

  --radius-sm: 10px;
  --radius: 18px;
  --radius-lg: 26px;
  --radius-full: 999px;

  --font-sans: "Inter", ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  --font-display: "Space Grotesk", "Inter", ui-sans-serif, system-ui, sans-serif;

  --header-h: 76px;
  --section-pad: clamp(64px, 8vw, 110px);
  color-scheme: light;
}

[data-theme="dark"] {
  --bg: #060b17;
  --surface: #0d1526;
  --surface-2: #131d33;
  --surface-3: #182342;
  --text: #f1f5fb;
  --text-soft: #c6d2e8;
  --muted: #94a3c0;
  --border: #1e2a47;
  --border-strong: #2b3a5e;

  --header: rgba(7, 12, 25, .82);
  --header-border: rgba(148, 163, 184, .14);
  --footer-bg: #04080f;

  --shadow-sm: 0 4px 16px rgba(0, 0, 0, .35);
  --shadow: 0 18px 55px rgba(0, 0, 0, .42);
  --shadow-lg: 0 30px 80px rgba(0, 0, 0, .55);
  color-scheme: dark;
}

/* ---------- Reset & base ---------- */
*, *::before, *::after { box-sizing: border-box; }

html { scroll-behavior: smooth; -webkit-text-size-adjust: 100%; }

body {
  margin: 0;
  background: var(--bg);
  color: var(--text);
  font-family: var(--font-sans);
  font-size: 1rem;
  line-height: 1.65;
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizeLegibility;
}

img { max-width: 100%; height: auto; display: block; }
a { color: var(--brand); text-decoration: none; }
a:hover { color: var(--brand); }
p { margin: 0 0 1rem; }
h1, h2, h3, h4, h5, h6 {
  font-family: var(--font-display);
  line-height: 1.18;
  letter-spacing: -.015em;
  margin: 0 0 .6rem;
  font-weight: 700;
}
button { font-family: inherit; }

::selection { background: rgba(91, 99, 238, .25); }

:focus-visible { outline: 2px solid var(--brand); outline-offset: 3px; border-radius: 4px; }

/* ---------- Utilities ---------- */
.container { width: min(1200px, calc(100% - 48px)); margin-inline: auto; }
.container-narrow { width: min(860px, calc(100% - 48px)); margin-inline: auto; }

.sr-only {
  position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
  overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0;
}

.skip-link {
  position: fixed; left: 16px; top: -70px; z-index: 200;
  background: var(--brand); color: #fff; padding: 10px 18px;
  border-radius: 10px; font-weight: 600; transition: top .2s ease;
}
.skip-link:focus { top: 16px; }

.section-kicker {
  display: inline-flex; align-items: center; gap: 8px;
  color: var(--brand); font-size: .78rem; font-weight: 800;
  text-transform: uppercase; letter-spacing: .16em;
}
.section-kicker::before {
  content: ""; width: 26px; height: 2px;
  background: var(--gradient); border-radius: 2px;
}

.gradient-text {
  background: var(--gradient);
  -webkit-background-clip: text; background-clip: text;
  -webkit-text-fill-color: transparent; color: transparent;
}

.badge {
  display: inline-flex; align-items: center; gap: 6px;
  padding: 6px 14px; border-radius: var(--radius-full);
  background: var(--gradient-soft); color: var(--brand);
  font-size: .8rem; font-weight: 700; border: 1px solid rgba(91,99,238,.25);
}
[data-theme="dark"] .badge { background: rgba(91,99,238,.18); }

/* ---------- Buttons ---------- */
.site-btn {
  display: inline-flex; align-items: center; justify-content: center; gap: 9px;
  padding: 13px 26px; border-radius: var(--radius-sm);
  background: var(--gradient); background-size: 160% 160%;
  color: #fff; font-weight: 700; font-size: .95rem; line-height: 1;
  border: 0; cursor: pointer; text-decoration: none;
  box-shadow: 0 10px 24px rgba(91, 99, 238, .32);
  transition: background-position .35s ease, transform .2s ease, box-shadow .25s ease;
  white-space: nowrap;
}
.site-btn:hover { background-position: 90% 50%; color: #fff; transform: translateY(-2px); box-shadow: 0 14px 30px rgba(91, 99, 238, .42); }
.site-btn:active { transform: translateY(0); }

.site-btn.secondary {
  background: transparent; color: var(--text);
  border: 1.5px solid var(--border-strong);
  box-shadow: none;
}
.site-btn.secondary:hover { border-color: var(--brand); color: var(--brand); background: var(--gradient-soft); box-shadow: none; }

.site-btn.ghost {
  background: rgba(255,255,255,.12); color: #fff;
  border: 1.5px solid rgba(255,255,255,.35); box-shadow: none;
  backdrop-filter: blur(6px);
}
.site-btn.ghost:hover { background: rgba(255,255,255,.2); color: #fff; box-shadow: none; }

.site-btn.sm { padding: 9px 18px; font-size: .86rem; }

.btn-row { display: flex; flex-wrap: wrap; gap: 14px; align-items: center; }

/* ---------- Header ---------- */
.site-header {
  position: sticky; top: 0; z-index: 90;
  background: var(--header);
  border-bottom: 1px solid var(--header-border);
  backdrop-filter: blur(18px) saturate(1.4);
  -webkit-backdrop-filter: blur(18px) saturate(1.4);
  transition: box-shadow .25s ease;
}
.site-header.is-scrolled { box-shadow: var(--shadow-sm); }

.site-nav-wrap {
  min-height: var(--header-h);
  display: flex; align-items: center; justify-content: space-between; gap: 18px;
  position: relative;
}

.site-brand {
  display: inline-flex; align-items: center; gap: 12px;
  text-decoration: none; color: var(--text); font-weight: 800;
  font-family: var(--font-display); font-size: 1.12rem; letter-spacing: -.01em;
  flex-shrink: 1; min-width: 0;
}
.site-brand:hover { color: var(--text); }
.site-brand img { height: 42px; width: auto; }
.site-brand .brand-mark {
  width: 42px; height: 42px; border-radius: 12px;
  background: var(--gradient); display: grid; place-items: center;
  color: #fff; font-size: 1.15rem; font-weight: 800;
  box-shadow: 0 8px 20px rgba(91, 99, 238, .35);
  flex-shrink: 0;
}
.site-brand .brand-name small {
  display: block; font-family: var(--font-sans);
  font-weight: 600; font-size: .66rem; letter-spacing: .18em;
  text-transform: uppercase; color: var(--muted); line-height: 1;
  margin-top: 3px;
}

/* Nav */
.site-nav { display: flex; align-items: center; gap: 4px; }
.site-nav > .nav-link, .nav-dropdown > .nav-trigger {
  display: inline-flex; align-items: center; gap: 7px;
  padding: 10px 13px; border-radius: var(--radius-sm);
  border: 0; background: none; cursor: pointer;
  color: var(--text-soft); font-size: .93rem; font-weight: 650;
  text-decoration: none; transition: color .18s ease, background .18s ease;
}
.site-nav > .nav-link:hover, .nav-dropdown > .nav-trigger:hover,
.site-nav > .nav-link[aria-current="page"], .nav-dropdown.is-open > .nav-trigger {
  color: var(--brand); background: var(--gradient-soft);
}
.nav-dropdown > .nav-trigger .fa-chevron-down { font-size: .68rem; transition: transform .2s ease; }
.nav-dropdown.is-open > .nav-trigger .fa-chevron-down { transform: rotate(180deg); }

/* Dropdown / mega panel — rendered exactly once per parent item */
.nav-dropdown { position: relative; }
.nav-dropdown-menu {
  position: absolute; top: calc(100% + 10px); left: 50%; transform: translateX(-50%) translateY(6px);
  min-width: 240px; padding: 10px;
  background: var(--surface); border: 1px solid var(--border);
  border-radius: var(--radius); box-shadow: var(--shadow-lg);
  opacity: 0; visibility: hidden; pointer-events: none;
  transition: opacity .18s ease, transform .18s ease, visibility .18s;
  z-index: 95;
  display: grid; gap: 2px;
}
.nav-dropdown:hover .nav-dropdown-menu,
.nav-dropdown:focus-within .nav-dropdown-menu,
.nav-dropdown.is-open .nav-dropdown-menu {
  opacity: 1; visibility: visible; pointer-events: auto; transform: translateX(-50%) translateY(0);
}
.nav-dropdown-menu::before {
  content: ""; position: absolute; top: -12px; left: 0; right: 0; height: 14px;
}
.nav-dropdown-menu a {
  display: flex; align-items: center; gap: 10px;
  padding: 10px 14px; border-radius: 9px;
  color: var(--text-soft); font-size: .9rem; font-weight: 600;
  text-decoration: none; transition: background .15s ease, color .15s ease, transform .15s ease;
}
.nav-dropdown-menu a i { color: var(--brand); font-size: .9rem; width: 18px; text-align: center; }
.nav-dropdown-menu a:hover { background: var(--gradient-soft); color: var(--brand); transform: translateX(3px); }

/* Header actions: search, theme, CTA */
.nav-actions { display: flex; align-items: center; gap: 8px; margin-left: 8px; flex-shrink: 0; }

.icon-btn {
  width: 40px; height: 40px; display: inline-grid; place-items: center;
  border: 1px solid var(--border); background: var(--surface);
  color: var(--text-soft); border-radius: var(--radius-sm);
  cursor: pointer; font-size: .95rem; text-decoration: none;
  transition: border-color .18s ease, color .18s ease, transform .18s ease, box-shadow .18s ease;
}
.icon-btn:hover { color: var(--brand); border-color: var(--brand); box-shadow: var(--ring); transform: translateY(-1px); }

.theme-switch { display: flex; padding: 3px; background: var(--surface-2); border-radius: var(--radius-sm); border: 1px solid var(--border); }
.theme-switch .theme-toggle-btn {
  border: 0; background: transparent; color: var(--muted);
  width: 32px; height: 32px; border-radius: 8px; cursor: pointer;
  font-size: .85rem; display: inline-grid; place-items: center;
  transition: background .18s ease, color .18s ease;
}
.theme-switch .theme-toggle-btn:hover { color: var(--text); }
.theme-switch .theme-toggle-btn.active { background: var(--surface); color: var(--brand); box-shadow: var(--shadow-sm); }

.nav-cta {
  display: inline-flex; align-items: center; gap: 8px;
  padding: 11px 20px; border-radius: var(--radius-sm);
  background: var(--gradient); background-size: 160% 160%;
  color: #fff !important; font-weight: 700; font-size: .9rem; text-decoration: none;
  box-shadow: 0 8px 20px rgba(91, 99, 238, .32);
  transition: background-position .35s ease, transform .2s ease;
}
.nav-cta:hover { background-position: 90% 50%; color: #fff !important; transform: translateY(-1px); }

.nav-toggle { display: none; }

/* ---------- Sections ---------- */
.cms-section { padding: var(--section-pad) 0; position: relative; }
.cms-section.alt { background: var(--surface); border-block: 1px solid var(--border); }
.cms-section.tint { background: var(--gradient-soft); border-block: 1px solid var(--border); }

.section-head { max-width: 760px; margin: 0 auto clamp(32px, 5vw, 52px); text-align: center; }
.section-head.left { margin-inline: 0; text-align: left; }
.section-head h2 { font-size: clamp(1.9rem, 4vw, 3rem); margin: 12px 0 14px; }
.section-head p { color: var(--muted); font-size: 1.06rem; margin: 0; }

/* ---------- Grid & cards ---------- */
.cms-grid {
  display: grid; gap: 26px;
  grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
}
.cms-grid.cols-2 { grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr)); }
.cms-grid.cols-4 { grid-template-columns: repeat(auto-fit, minmax(min(100%, 230px), 1fr)); }

.cms-card {
  background: var(--surface); border: 1px solid var(--border);
  border-radius: var(--radius); padding: 28px;
  box-shadow: var(--shadow-sm);
  display: flex; flex-direction: column; gap: 10px;
  position: relative; overflow: hidden;
  transition: transform .25s ease, box-shadow .25s ease, border-color .25s ease;
}
.cms-card:hover { transform: translateY(-6px); box-shadow: var(--shadow); border-color: var(--border-strong); }
.cms-card h3 { font-size: 1.18rem; margin: 0; }
.cms-card p { color: var(--muted); font-size: .94rem; margin: 0; }
.cms-card > a:not(.site-btn) {
  color: var(--brand); font-weight: 700; font-size: .9rem;
  display: inline-flex; align-items: center; gap: 7px; margin-top: auto; padding-top: 8px;
  width: fit-content;
}
.cms-card > a:not(.site-btn):hover { gap: 10px; }

.cms-card-icon {
  width: 54px; height: 54px; border-radius: 14px;
  display: grid; place-items: center;
  background: var(--gradient-soft); color: var(--brand);
  font-size: 1.3rem; margin-bottom: 4px;
  transition: transform .25s ease;
}
.cms-card:hover .cms-card-icon { transform: scale(1.08) rotate(-3deg); }

.cms-card img { border-radius: 12px; width: 100%; object-fit: cover; }
.cms-card .card-media { margin: -28px -28px 6px; }
.cms-card .card-media img { border-radius: 0 0 0 0; aspect-ratio: 16/10; }

.cms-card .card-tag {
  align-self: flex-start; font-size: .72rem; font-weight: 800;
  text-transform: uppercase; letter-spacing: .1em;
  color: var(--brand); background: var(--gradient-soft);
  padding: 5px 12px; border-radius: var(--radius-full);
}

/* Stats */
.stats-band {
  display: grid; gap: 24px;
  grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr));
  text-align: center;
}
.stat-item { padding: 26px 12px; }
.stat-value {
  font-family: var(--font-display); font-weight: 800;
  font-size: clamp(2rem, 4vw, 2.9rem); line-height: 1;
  background: var(--gradient);
  -webkit-background-clip: text; background-clip: text;
  -webkit-text-fill-color: transparent;
}
.stat-label { color: var(--muted); font-weight: 600; font-size: .92rem; margin-top: 10px; }

/* Testimonial */
.cms-card blockquote { margin: 0; }
.cms-card blockquote p { color: var(--text-soft); font-size: 1rem; font-style: italic; }
.cms-card .t-author { display: flex; align-items: center; gap: 12px; margin-top: auto; padding-top: 14px; }
.cms-card .t-author .t-avatar {
  width: 46px; height: 46px; border-radius: 50%;
  background: var(--gradient); color: #fff;
  display: grid; place-items: center; font-weight: 800; font-size: .95rem;
  flex-shrink: 0;
}
.cms-card .t-author strong { display: block; font-size: .95rem; }
.cms-card .t-author span { color: var(--muted); font-size: .84rem; }
.t-stars { color: var(--warning); font-size: .8rem; letter-spacing: 2px; }

/* FAQ */
details.cms-card { height: auto; padding: 0; margin-bottom: 14px; }
details.cms-card summary {
  list-style: none; cursor: pointer; padding: 20px 24px;
  display: flex; align-items: center; justify-content: space-between; gap: 14px;
  font-weight: 700; font-size: 1rem;
}
details.cms-card summary::-webkit-details-marker { display: none; }
details.cms-card summary::after {
  content: "\f078"; font-family: "Font Awesome 6 Free"; font-weight: 900;
  font-size: .8rem; color: var(--brand); flex-shrink: 0;
  transition: transform .2s ease;
}
details.cms-card[open] summary::after { transform: rotate(180deg); }
details.cms-card[open] summary { color: var(--brand); }
details.cms-card .faq-body { padding: 0 24px 20px; color: var(--muted); font-size: .95rem; }
details.cms-card .faq-body p { margin: 0; }

/* ---------- Contact ---------- */
.contact-layout { display: grid; gap: 34px; grid-template-columns: 1.05fr 1fr; align-items: start; }
.contact-info-list { display: grid; gap: 16px; margin-top: 8px; }
.contact-info-item {
  display: flex; gap: 15px; align-items: flex-start;
  background: var(--surface); border: 1px solid var(--border);
  border-radius: var(--radius); padding: 18px 20px;
}
.contact-info-item .ci-icon {
  width: 44px; height: 44px; flex-shrink: 0; border-radius: 12px;
  background: var(--gradient-soft); color: var(--brand);
  display: grid; place-items: center; font-size: 1.05rem;
}
.contact-info-item h4 { margin: 0 0 2px; font-size: .98rem; }
.contact-info-item p, .contact-info-item a { margin: 0; color: var(--muted); font-size: .92rem; }
.contact-info-item a:hover { color: var(--brand); }

.cms-form { display: grid; gap: 16px; }
.cms-form .form-row { display: grid; gap: 16px; grid-template-columns: 1fr 1fr; }
.cms-form label { display: grid; gap: 7px; font-weight: 650; font-size: .88rem; }
.cms-form input, .cms-form textarea, .cms-form select {
  width: 100%; padding: 13px 15px;
  border: 1.5px solid var(--border-strong); border-radius: var(--radius-sm);
  background: var(--surface); color: var(--text); font: inherit; font-size: .95rem;
  transition: border-color .18s ease, box-shadow .18s ease;
}
.cms-form input:focus, .cms-form textarea:focus, .cms-form select:focus {
  outline: none; border-color: var(--brand); box-shadow: var(--ring);
}
.cms-form textarea { resize: vertical; min-height: 130px; }

.contact-map {
  margin-top: 40px; overflow: hidden;
  border: 1px solid var(--border); border-radius: var(--radius-lg);
  box-shadow: var(--shadow); position: relative;
  background: var(--surface-2);
}
.contact-map iframe { display: block; width: 100%; height: 430px; border: 0; }
.contact-map .map-fallback {
  min-height: 260px; display: grid; place-items: center; text-align: center;
  padding: 40px; color: var(--muted);
}

/* ---------- Footer ---------- */
.site-footer {
  background: var(--footer-bg); color: var(--footer-text);
  position: relative; overflow: hidden;
}
.site-footer::before {
  content: ""; position: absolute; inset: 0;
  background:
    radial-gradient(600px 300px at 12% 0%, rgba(91,99,238,.22), transparent 60%),
    radial-gradient(500px 260px at 88% 100%, rgba(34,211,238,.12), transparent 60%);
  pointer-events: none;
}
.footer-grid {
  position: relative;
  display: grid; gap: 44px;
  grid-template-columns: 1.6fr 1fr 1fr 1fr;
  padding: clamp(48px, 7vw, 76px) 0 40px;
}
.footer-brand p { color: var(--footer-muted); font-size: .93rem; max-width: 340px; }
.footer-brand .site-brand { color: #fff; margin-bottom: 14px; }
.footer-brand .site-brand small { color: var(--footer-muted); }
.social-row { display: flex; gap: 10px; margin-top: 18px; }
.social-row a {
  width: 40px; height: 40px; border-radius: 11px;
  display: grid; place-items: center;
  background: rgba(255,255,255,.06); color: var(--footer-text);
  font-size: .95rem; transition: background .2s ease, color .2s ease, transform .2s ease;
}
.social-row a:hover { background: var(--gradient); color: #fff; transform: translateY(-3px); }

.footer-col h3 {
  color: #fff; font-size: 1rem; margin: 0 0 18px;
  letter-spacing: .02em; text-transform: uppercase; font-size: .84rem;
}
.footer-col p { color: var(--footer-muted); font-size: .92rem; }
.footer-links { display: grid; gap: 10px; }
.footer-links a {
  color: var(--footer-muted); font-size: .93rem;
  transition: color .18s ease, transform .18s ease;
  width: fit-content; display: inline-flex; align-items: center; gap: 8px;
}
.footer-links a:hover { color: #fff; transform: translateX(3px); }
.footer-links a i { font-size: .8rem; color: var(--brand); }

.footer-newsletter input {
  width: 100%; padding: 12px 14px; border-radius: var(--radius-sm);
  border: 1px solid rgba(255,255,255,.14); background: rgba(255,255,255,.06);
  color: #fff; font: inherit; font-size: .92rem; margin-bottom: 10px;
}
.footer-newsletter input::placeholder { color: var(--footer-muted); }

.footer-bottom {
  position: relative;
  border-top: 1px solid rgba(255,255,255,.08);
  padding: 22px 0;
  display: flex; flex-wrap: wrap; gap: 12px; align-items: center; justify-content: space-between;
  color: var(--footer-muted); font-size: .86rem;
}
.footer-bottom a { color: var(--footer-muted); }
.footer-bottom a:hover { color: #fff; }

/* ---------- Search ---------- */
.search-form { display: flex; gap: 12px; max-width: 780px; margin: 0 auto 36px; }
.search-form input {
  flex: 1; padding: 15px 18px;
  border: 1.5px solid var(--border-strong); border-radius: var(--radius);
  background: var(--surface); color: var(--text); font: inherit; font-size: 1rem;
  box-shadow: var(--shadow-sm);
}
.search-form input:focus { outline: none; border-color: var(--brand); box-shadow: var(--ring); }
.search-result-count { text-align: center; color: var(--muted); margin-bottom: 28px; }

/* ---------- Hero (static / non-carousel pages) ---------- */
.cms-hero {
  min-height: 560px; display: grid; align-items: center;
  position: relative; overflow: hidden;
  background: radial-gradient(1000px 500px at 85% -10%, rgba(91,99,238,.5), transparent 55%),
              radial-gradient(700px 400px at -10% 110%, rgba(34,211,238,.28), transparent 55%),
              linear-gradient(135deg, var(--brand-2) 0%, #14204a 60%, #1b2a5e 100%);
  color: #fff;
}
.cms-hero .container { position: relative; z-index: 2; }
.hero-inner { max-width: 780px; }
.hero-inner .section-kicker { color: var(--accent); }
.hero-inner .section-kicker::before { background: var(--accent); }
.hero-inner h1 {
  font-size: clamp(2.3rem, 5.4vw, 4rem); color: #fff; margin: 16px 0 18px;
  letter-spacing: -.025em;
}
.hero-inner h1 .gradient-text { -webkit-text-fill-color: transparent; }
.hero-inner p { color: rgba(255,255,255,.82); font-size: 1.12rem; max-width: 620px; }
.hero-inner .btn-row { margin-top: 28px; }

/* ---------- CTA band ---------- */
.cta-band {
  border-radius: var(--radius-lg); overflow: hidden; position: relative;
  background: radial-gradient(700px 400px at 90% 10%, rgba(139,92,246,.55), transparent 55%),
              radial-gradient(500px 300px at 5% 110%, rgba(34,211,238,.4), transparent 55%),
              linear-gradient(135deg, var(--brand-2), #1b2a5e);
  color: #fff; padding: clamp(40px, 6vw, 70px);
  text-align: center; box-shadow: var(--shadow-lg);
}
.cta-band h2 { color: #fff; font-size: clamp(1.7rem, 3.6vw, 2.6rem); margin-bottom: 12px; }
.cta-band p { color: rgba(255,255,255,.82); max-width: 640px; margin: 0 auto 26px; }

/* ---------- Text / image components ---------- */
.content-body { color: var(--text-soft); font-size: 1.02rem; }
.content-body p { margin-bottom: 1.1rem; }
.cms-image-text {
  display: grid; gap: 40px; align-items: center;
  grid-template-columns: 1fr 1fr;
}
.cms-image-text .img-side img {
  width: 100%; border-radius: var(--radius-lg);
  box-shadow: var(--shadow-lg); aspect-ratio: 4/3; object-fit: cover;
}
.cms-image-text .text-side .section-kicker { margin-bottom: 10px; }
.cms-image-text .text-side h2 { font-size: clamp(1.7rem, 3.4vw, 2.5rem); }
.cms-image-text .text-side p { color: var(--muted); }

/* ---------- Animation (lightweight) ---------- */
.reveal { opacity: 0; transform: translateY(22px); transition: opacity .6s ease, transform .6s ease; }
.reveal.is-visible { opacity: 1; transform: none; }

/* ---------- Responsive ---------- */
@media (max-width: 1024px) {
  .footer-grid { grid-template-columns: 1fr 1fr; }
  .nav-cta { display: none; }
}

@media (max-width: 860px) {
  .nav-toggle { display: inline-grid; }
  .site-nav {
    position: fixed; inset: 0 0 0 auto; z-index: 120;
    width: min(340px, 88vw); height: 100dvh;
    background: var(--surface);
    border-left: 1px solid var(--border);
    box-shadow: var(--shadow-lg);
    flex-direction: column; align-items: stretch; gap: 2px;
    padding: 84px 20px 28px; overflow-y: auto;
    transform: translateX(105%); transition: transform .28s ease;
  }
  .site-nav.is-open { transform: translateX(0); }
  .site-nav > .nav-link, .nav-dropdown > .nav-trigger {
    width: 100%; justify-content: space-between; padding: 14px 14px; font-size: 1rem;
  }
  .nav-dropdown { width: 100%; }
  .nav-dropdown-menu {
    position: static; transform: none; opacity: 1; visibility: visible; pointer-events: auto;
    display: none; box-shadow: none; border: 0; border-left: 2px solid var(--brand);
    border-radius: 0; margin: 0 6px 4px 14px; padding: 4px 0; background: transparent; min-width: 0;
  }
  .nav-dropdown.is-open .nav-dropdown-menu { display: grid; }
  .nav-dropdown:hover .nav-dropdown-menu { display: none; }
  .nav-dropdown:hover.is-open .nav-dropdown-menu { display: grid; }
  .nav-actions { width: 100%; justify-content: space-between; margin-left: 0; margin-top: 16px; padding-top: 16px; border-top: 1px solid var(--border); }
  .nav-cta { display: inline-flex; }
  .contact-layout { grid-template-columns: 1fr; }
  .cms-image-text { grid-template-columns: 1fr; }
  .cms-form .form-row { grid-template-columns: 1fr; }
}

@media (max-width: 600px) {
  html, body { max-width: 100%; overflow-x: clip; }
  .site-brand .brand-name { min-width: 0; max-width: calc(100vw - 96px); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .site-brand .brand-name small { overflow: hidden; text-overflow: ellipsis; }
  .nav-toggle { flex-shrink: 0; }
  .carousel-slide h1 { font-size: clamp(2rem, 10vw, 2.75rem); overflow-wrap: anywhere; }
  .carousel-slide p { overflow-wrap: anywhere; }
  .container { width: min(1200px, calc(100% - 32px)); }
  .footer-grid { grid-template-columns: 1fr; gap: 34px; }
  .btn-row .site-btn { width: 100%; }
  .cms-hero { min-height: 520px; }
  .theme-switch .theme-toggle-btn { width: 30px; height: 30px; }
  .contact-map iframe { height: 320px; }
}

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after { animation-duration: .01ms !important; transition-duration: .01ms !important; }
  html { scroll-behavior: auto; }
  .reveal { opacity: 1; transform: none; }
}

/* ============================================================
   COMPONENT CLASS ALIGNMENT LAYER
   Styles for the exact class names used by the section
   component templates (contact, faq, jobs, pricing, image,
   testimonials, team, search, cta, carousel).
   ============================================================ */

/* --- Carousel track --- */
.carousel-track { position: relative; }

/* --- CTA band internals --- */
.cta-band { position: relative; text-align: center; }
.cta-glow {
  position: absolute; border-radius: 50%; filter: blur(90px);
  pointer-events: none; opacity: .5;
}
.cta-glow.g1 { width: 360px; height: 360px; background: rgba(91,99,238,.6); top: -160px; right: -60px; }
.cta-glow.g2 { width: 300px; height: 300px; background: rgba(34,211,238,.35); bottom: -140px; left: -40px; }
.cta-content { position: relative; z-index: 2; }
.cta-content .btn-row { justify-content: center; }

/* --- Buttons: light variants (on dark CTA bands) --- */
.site-btn.light {
  background: #fff; color: #0d1526;
  box-shadow: 0 12px 30px rgba(0,0,0,.28);
}
.site-btn.light:hover { background: var(--accent); color: #04202b; box-shadow: 0 14px 34px rgba(0,0,0,.32); }
.site-btn.ghost-light {
  background: transparent; color: #fff;
  border: 1.5px solid rgba(255,255,255,.55);
}
.site-btn.ghost-light:hover { background: rgba(255,255,255,.14); color: #fff; border-color: #fff; box-shadow: none; }
.site-btn.wide { width: 100%; justify-content: center; }

/* --- Contact page layout --- */
.contact-grid { display: grid; gap: 34px; grid-template-columns: 1fr 1.15fr; align-items: start; }
.contact-info { display: grid; gap: 16px; }
.contact-block {
  display: flex; gap: 16px; align-items: flex-start;
  background: var(--surface); border: 1px solid var(--border);
  border-radius: var(--radius); padding: 20px 22px;
  box-shadow: var(--shadow-sm);
  transition: transform .22s ease, box-shadow .22s ease, border-color .22s ease;
}
.contact-block:hover { transform: translateY(-3px); box-shadow: var(--shadow); border-color: var(--border-strong); }
.contact-block > i {
  width: 46px; height: 46px; flex-shrink: 0; border-radius: 12px;
  background: var(--gradient-soft); color: var(--brand);
  display: grid; place-items: center; font-size: 1.05rem;
}
.contact-block h3 { margin: 0 0 3px; font-size: 1rem; }
.contact-block p { margin: 0; color: var(--muted); font-size: .93rem; word-break: break-word; }
.contact-block a { color: var(--muted); font-weight: 600; }
.contact-block a:hover { color: var(--brand); }

.contact-form { display: grid; gap: 16px; padding: 30px; }
.contact-form .form-row { display: grid; gap: 16px; grid-template-columns: 1fr 1fr; }
.contact-form .form-field { display: grid; gap: 7px; }
.contact-form label { font-weight: 650; font-size: .88rem; }
.contact-form input, .contact-form textarea, .contact-form select {
  width: 100%; padding: 13px 15px;
  border: 1.5px solid var(--border-strong); border-radius: var(--radius-sm);
  background: var(--surface); color: var(--text); font: inherit; font-size: .95rem;
  transition: border-color .18s ease, box-shadow .18s ease;
}
.contact-form input:focus, .contact-form textarea:focus, .contact-form select:focus {
  outline: none; border-color: var(--brand); box-shadow: var(--ring);
}
.contact-form textarea { resize: vertical; min-height: 140px; }

.map-cta {
  position: absolute; right: 18px; bottom: 18px; z-index: 2;
  display: inline-flex; align-items: center; gap: 8px;
  padding: 11px 18px; border-radius: var(--radius-sm);
  background: var(--gradient); color: #fff !important;
  font-weight: 700; font-size: .88rem; text-decoration: none;
  box-shadow: 0 10px 24px rgba(0,0,0,.35);
  transition: transform .2s ease;
}
.map-cta:hover { transform: translateY(-2px); color: #fff !important; }

/* --- FAQ list --- */
.faq-list { display: grid; gap: 14px; }
.faq-item {
  background: var(--surface); border: 1px solid var(--border);
  border-radius: var(--radius); box-shadow: var(--shadow-sm);
  padding: 0; overflow: hidden;
  transition: border-color .2s ease, box-shadow .2s ease;
}
.faq-item[open] { border-color: var(--brand); box-shadow: var(--ring); }
.faq-item summary {
  list-style: none; cursor: pointer; user-select: none;
  display: flex; align-items: center; justify-content: space-between; gap: 14px;
  padding: 18px 22px; font-weight: 700; font-size: 1rem; color: var(--text);
  transition: color .18s ease;
}
.faq-item summary::-webkit-details-marker { display: none; }
.faq-item summary i { color: var(--brand); font-size: .85rem; transition: transform .22s ease; flex-shrink: 0; }
.faq-item[open] summary { color: var(--brand); }
.faq-item[open] summary i { transform: rotate(180deg); }
.faq-item p { margin: 0; padding: 0 22px 20px; color: var(--muted); font-size: .95rem; }

/* --- Jobs list --- */
.job-list { display: grid; gap: 18px; }
.job-card { display: flex; gap: 22px; align-items: center; justify-content: space-between; }
.job-main { display: grid; gap: 8px; min-width: 0; }
.job-main h3 { margin: 0; font-size: 1.22rem; }
.job-main p { margin: 0; }
.job-meta { display: flex; flex-wrap: wrap; gap: 8px; }
.job-meta span {
  font-size: .78rem; font-weight: 700;
  padding: 5px 12px; border-radius: var(--radius-full);
  background: var(--gradient-soft); color: var(--brand);
  display: inline-flex; align-items: center; gap: 6px;
}
.job-apply { flex-shrink: 0; }

/* --- Pricing --- */
.pricing-price {
  display: flex; align-items: baseline; gap: 4px;
  font-family: var(--font-display); font-weight: 800; font-size: 2.3rem;
  color: var(--text);
}
.pricing-price .currency { font-size: 1.3rem; color: var(--brand); }
.pricing-price small { font-size: .9rem; color: var(--muted); font-weight: 600; }
.pricing-features { list-style: none; margin: 6px 0 0; padding: 0; display: grid; gap: 9px; }
.pricing-features li { position: relative; padding-left: 26px; color: var(--text-soft); font-size: .93rem; }
.pricing-features li::before {
  content: "\f00c"; font-family: "Font Awesome 6 Free"; font-weight: 900;
  position: absolute; left: 0; top: 1px; color: var(--success); font-size: .82rem;
}
.pricing-badge {
  position: absolute; top: 16px; right: 16px;
  background: var(--gradient); color: #fff;
  font-size: .7rem; font-weight: 800; letter-spacing: .1em; text-transform: uppercase;
  padding: 6px 12px; border-radius: var(--radius-full);
  box-shadow: 0 6px 16px rgba(91,99,238,.4);
}

/* --- Prose (text component) --- */
.prose { font-size: 1.02rem; color: var(--text-soft); }
.prose p { margin-bottom: 1.1rem; }
.prose ul, .prose ol { padding-left: 22px; margin-bottom: 1.1rem; }
.prose a { font-weight: 600; }

/* --- Testimonials --- */
.testimonial-card { padding: 30px; }
.testimonial-stars { display: flex; gap: 3px; color: var(--warning); font-size: .85rem; }
.quote-mark {
  font-size: 1.9rem; color: var(--brand);
  background: var(--gradient);
  -webkit-background-clip: text; background-clip: text;
  -webkit-text-fill-color: transparent;
}
.testimonial-card blockquote { margin: 4px 0 18px; }
.testimonial-card blockquote p { color: var(--text-soft); font-size: .98rem; font-style: italic; margin: 0; }
.testimonial-card figcaption {
  display: flex; align-items: center; gap: 12px;
  border-top: 1px solid var(--border); padding-top: 16px; margin-top: auto;
}
.avatar { width: 48px; height: 48px; border-radius: 50%; object-fit: cover; flex-shrink: 0; }
.avatar-initials {
  display: grid; place-items: center; flex-shrink: 0;
  width: 48px; height: 48px; border-radius: 50%;
  background: var(--gradient); color: #fff;
  font-family: var(--font-display); font-weight: 800; font-size: 1rem;
}
.avatar-meta { display: grid; line-height: 1.35; }
.avatar-meta strong { font-size: .96rem; }
.avatar-meta small { color: var(--muted); font-size: .82rem; }

/* --- Image & text split --- */
.split-grid {
  display: grid; gap: 44px; align-items: center;
  grid-template-columns: 1fr 1fr;
}
.split-media { margin: 0; }
.split-media img {
  width: 100%; border-radius: var(--radius-lg);
  box-shadow: var(--shadow-lg); aspect-ratio: 4/3; object-fit: cover;
}
.split-body .section-kicker { margin-bottom: 10px; }
.split-body h2 { font-size: clamp(1.7rem, 3.4vw, 2.5rem); margin: 10px 0 14px; }
.split-body p { color: var(--muted); }

/* --- Team --- */
.team-photo {
  width: 96px; height: 96px; border-radius: 50%; object-fit: cover;
  margin: 0 auto 10px; display: block;
  box-shadow: 0 12px 28px rgba(91,99,238,.32);
}
.team-photo-initials {
  display: grid; place-items: center;
  width: 96px; height: 96px; border-radius: 50%;
  background: var(--gradient); color: #fff;
  font-family: var(--font-display); font-weight: 800; font-size: 1.6rem;
  margin: 0 auto 10px;
  box-shadow: 0 12px 28px rgba(91,99,238,.4);
}
.team-social { display: flex; gap: 8px; justify-content: center; margin-top: 4px; }
.team-social a {
  width: 36px; height: 36px; border-radius: 10px;
  display: grid; place-items: center;
  background: var(--surface-2); color: var(--text-soft);
  font-size: .9rem; transition: all .2s ease;
}
.team-social a:hover { background: var(--gradient); color: #fff; transform: translateY(-2px); }

/* --- Search results --- */
.search-results { display: grid; gap: 18px; }
.search-result { padding: 24px 28px; }
.search-result h3 { margin: 2px 0 6px; }
.search-result h3 a { color: var(--text); }
.search-result h3 a:hover { color: var(--brand); }
.result-link {
  font-weight: 700; font-size: .9rem; margin-top: auto;
  display: inline-flex; align-items: center; gap: 7px;
}
.search-count { text-align: center; color: var(--text-soft); margin-bottom: 26px; font-size: 1.05rem; }
.empty-state {
  text-align: center; padding: 44px 30px; color: var(--muted);
  display: grid; justify-items: center; gap: 10px;
}
.empty-state i { font-size: 2rem; color: var(--brand); }
.empty-state p { margin: 0; }

/* --- Mega navigation (multi-item dropdown panels) --- */
.nav-dropdown-menu.mega {
  min-width: 560px;
  grid-template-columns: repeat(2, 1fr);
  padding: 14px;
}
.nav-dropdown-menu.mega a { padding: 11px 14px; }

/* --- Responsive for alignment layer --- */
@media (max-width: 900px) {
  .contact-grid { grid-template-columns: 1fr; }
  .split-grid { grid-template-columns: 1fr; }
  .job-card { flex-direction: column; align-items: flex-start; }
  .job-apply { width: 100%; }
  .job-apply .site-btn { width: 100%; justify-content: center; }
  .nav-dropdown-menu.mega { min-width: 320px; grid-template-columns: 1fr; }
}

@media (max-width: 600px) {
  .contact-form .form-row { grid-template-columns: 1fr; }
  .contact-form { padding: 22px; }
  .nav-dropdown-menu.mega { min-width: 0; width: calc(100vw - 64px); }
}
