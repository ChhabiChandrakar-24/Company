DEBUG=False
SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_VALUE
ALLOWED_HOSTS=hr.example.com
CSRF_TRUSTED_ORIGINS=https://hr.example.com
TIME_ZONE=Asia/Kolkata

# Local MariaDB on this EC2 instance. URL-encode password characters.
DATABASE_URL=mysql://chhabi_app:REPLACE_PASSWORD@127.0.0.1:3306/chhabi
DB_INIT_PASSWORD=REPLACE_WITH_ANOTHER_RANDOM_VALUE

STATIC_ROOT=/opt/chhabi/shared/staticfiles
MEDIA_URL=/media/
MEDIA_ROOT=/opt/chhabi/shared/media

SECURE_HSTS_SECONDS=3600
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PHONEPE_MERCHANT_ID=
PHONEPE_SALT_KEY=
PHONEPE_SALT_INDEX=1
PHONEPE_ENV=production
